# =============================================================
# 智工云枢（ICOPS）MVP 环境变量模板
# 依据《研制实施指导书 V1.0》附录 B 建立。
# 使用方式：复制本文件为仓库根目录 .env 后填入实际值。
#   cp deploy/.env.example .env
# 密钥严禁落入 Git 仓库；演示环境 APP_ENV 必须为 demo。
# =============================================================

# --- 环境标识 ---
APP_ENV=dev                 # dev | demo（演示环境必须为 demo）
APP_HOST=0.0.0.0
APP_PORT=8000

# --- 大模型网关（主通道 DeepSeek / 备用 通义千问，OpenAI 兼容协议）---
# 双模式说明：
#   * 不填任何密钥  -> 离线演示模式：LLM 由确定性模板引擎兜底，系统可完整运行；
#   * 填入密钥      -> 自动切换真实大模型；主通道连续失败自动切备用（容灾）。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_BACKUP_PROVIDER=dashscope
LLM_BACKUP_MODEL=qwen-plus
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BACKUP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
LLM_TIMEOUT_STREAM_FIRST_BYTE=3        # 流式首字节超时（秒）
LLM_TIMEOUT_STREAM_TOTAL=60            # 流式整体超时（秒）
LLM_TIMEOUT_NON_STREAM=30              # 非流式超时（秒）
LLM_MAX_RETRIES=2                      # 幂等重试次数
LLM_DAILY_BUDGET_CNY=50                # 日预算告警（元）

# --- Embedding ---
# dashscope（真实嵌入，需 DASHSCOPE_API_KEY）| local（离线哈希嵌入，演示用）
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-v3

# --- 地图（高德开放平台，前端展示用；后端仅在需要地理编码/围栏计算时使用）---
AMAP_KEY=
# 高德 JS API 2.0 安全密钥（jscode），申请 Key 时一同生成，用于前端地图鉴权
AMAP_SECURITY_CODE=

# --- 数据库与向量库 ---
DATABASE_URL=sqlite:///./data/icops.db
VECTOR_STORE_PATH=./data/vectorstore
VECTOR_BACKEND=auto        # auto（优先 chroma，不可用则内置降级）| chroma | builtin

# --- RAG 检索参数（附录 B 基线）---
RAG_TOP_K=5
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=0.12

# --- 会话安全 ---
JWT_SECRET=CHANGE_ME_to_a_long_random_secret
TOKEN_TTL_HOURS=12

# --- 可观测（Langfuse，可选：自部署后填入，否则记录到本地日志）---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- 方案文档导出 ---
# PDF 转换依赖 LibreOffice 无头模式；未安装时仅提供 Word 导出。
LIBREOFFICE_PATH=auto       # auto 自动探测 soffice，或填可执行文件绝对路径
